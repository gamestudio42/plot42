{
  "name": "plot42",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Plot 42 \u2014 a static browser game platform: lobby, Horta, Posto, Mata and Sítio. Urbe and Neo Urbe live in their own repositories.",
  "license": "MIT",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @plot42/lobby dev",
    "lobby": "pnpm --filter @plot42/lobby dev",
    "horta": "pnpm --filter @horta/web dev",
    "posto": "pnpm --filter @posto/web dev",
    "mata": "pnpm --filter @mata/web dev",
    "sitio": "pnpm --filter @sitio/web dev",
    "build": "pnpm build:site",
    "build:site": "tsx tools/build-site.ts",
    "preview": "pnpm preview:site",
    "preview:site": "tsx tools/preview-site.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p packages/kernel && tsc -p packages/bridge && tsc -p packages/view-iso && tsc -p packages/chrome && tsc -p packages/horta && tsc -p packages/posto && tsc -p packages/mata && tsc -p packages/sitio && tsc -p apps/horta && tsc -p apps/posto && tsc -p apps/mata && tsc -p apps/sitio && tsc -p apps/lobby && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "art": "tsx tools/build-art.ts",
    "art:draw": "tsx tools/build-art.ts --draw"
  },
  "devDependencies": {
    "@horta/sim": "workspace:*",
    "@posto/sim": "workspace:*",
    "@mata/sim": "workspace:*",
    "@sitio/sim": "workspace:*",
    "@shell/kernel": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
