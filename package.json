{
  "name": "plot42",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Plot 42 — a static browser game platform: Urbe, Horta and Posto.",
  "license": "MIT",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @city/web dev",
    "lobby": "pnpm --filter @plot42/lobby dev",
    "horta": "pnpm --filter @horta/web dev",
    "posto": "pnpm --filter @posto/web dev",
    "build": "pnpm --filter @city/web build",
    "build:site": "tsx tools/build-site.ts",
    "preview": "pnpm --filter @city/web preview",
    "preview:site": "tsx tools/preview-site.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p packages/kernel && tsc -p packages/shared && tsc -p packages/simulation && tsc -p packages/bridge && tsc -p packages/view-iso && tsc -p packages/chrome && tsc -p packages/horta && tsc -p packages/posto && tsc -p apps/web && tsc -p apps/horta && tsc -p apps/posto && tsc -p apps/lobby && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:simulation": "vitest run --config vitest.scenarios.config.ts",
    "test:e2e": "playwright test",
    "sim": "tsx tools/headless-sim.ts",
    "bench": "tsx tools/benchmark.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:simulation && pnpm build"
  },
  "devDependencies": {
    "@city/shared": "workspace:*",
    "@city/simulation": "workspace:*",
    "@horta/sim": "workspace:*",
    "@posto/sim": "workspace:*",
    "@shell/kernel": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
